{
  "id": "t_maze",
  "label": "T-Maze",
  "description": "T-shaped maze with a stem, two goal arms, and a choice point.",
  "arena": {"shape": "T", "stem_length_cm": 40, "arm_length_cm": 30, "arm_width_cm": 8},
  "zones": [
    {"name": "stem",         "type": "rect", "coords": [[0.40, 0.30], [0.60, 1.00]], "color": "#60a5fa"},
    {"name": "choice_point", "type": "rect", "coords": [[0.40, 0.20], [0.60, 0.30]], "color": "#a855f7"},
    {"name": "left_arm",     "type": "rect", "coords": [[0.00, 0.05], [0.40, 0.30]], "color": "#fbbf24", "tags": ["arm"]},
    {"name": "right_arm",    "type": "rect", "coords": [[0.60, 0.05], [1.00, 0.30]], "color": "#34d399", "tags": ["arm"]},
    {"name": "left_reward",  "type": "rect", "coords": [[0.00, 0.05], [0.15, 0.30]], "color": "#fb7185", "tags": ["reward"]},
    {"name": "right_reward", "type": "rect", "coords": [[0.85, 0.05], [1.00, 0.30]], "color": "#fb7185", "tags": ["reward"]}
  ],
  "default_measures": ["distance", "speed", "choice_accuracy", "latency"],
  "default_plots":    ["trajectory", "heatmap", "zone_bar"]
}
