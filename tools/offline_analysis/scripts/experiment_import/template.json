{
  "id": "experiment_import",
  "name": "Experiment Data Import",
  "version": "1.0",
  "description": "Import all sessions from a folder as an experiment.",
  "input": {
    "type": "FOLDER",
    "file_filter": ""
  },
  "parameters": [
    {"name": "time_unit", "label": "Time Unit", "type": "CHOICE",
     "default": "ms", "choices": ["ms", "second"]}
  ],
  "columns": [
    {"key": "subject_id", "label": "Subject"},
    {"key": "session_date", "label": "Date"},
    {"key": "box_id", "label": "Box"}
  ],
  "legacy_adapter": true
}
